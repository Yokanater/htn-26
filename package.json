{
  "name": "grove-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/api/src/index.ts",
    "browserbase:smoke": "tsx scripts/browserbase-smoke.ts",
    "browserbase:profile": "tsx scripts/browserbase-profile.ts",
    "browserbase:market": "tsx scripts/browserbase-market.ts",
    "test": "tsx --test tests/api.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages/contracts tests vite.config.ts playwright.config.ts tsconfig.json package.json README.md docs/PLATFORM_HANDOFF.md"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.20.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dotenv": "^18.0.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "playwright-core": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
