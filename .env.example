PORT=3001
HOST=127.0.0.1
DATABASE_PATH=.data/grove.sqlite
# Use `browserbase` to extract a live store profile. Reports remain deterministic fixtures.
PROVIDER_MODE=demo

# Required for Browserbase-backed research and `npm run browserbase:smoke`.
BROWSERBASE_API_KEY=
# Optional when the API key belongs to one project; explicit is safer in shared accounts.
BROWSERBASE_PROJECT_ID=
