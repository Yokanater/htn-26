# Copy to `.env` at the repo root (git-ignored). Keys are shared out of band, never committed.
# Server-only unless prefixed VITE_ (VITE_* values are shipped to the browser: no secrets).
# Sources: design §3.6 (config), §13.1 (budgets), M5 §3 (Shopify write-back), README §3 (presets).

# --- Local ports and milestone preset -------------------------------------------------------
# Server port (apps/server). Tests never bind it; use another value per worktree if busy.
PORT=8787
# Web dev server port (apps/web); it proxies /api to http://localhost:${PORT}.
WEB_PORT=5173
# Enabled milestones, e.g. m1 | m1,m4 | m1,m2,m3,m4,m5 (packages/core/src/milestones.ts).
MILESTONES=m1

# --- Browserbase (L1) ---------------------------------------------------------------------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- OpenAI (L3) --------------------------------------------------------------------------------
OPENAI_API_KEY=
# Set in Block 0: current flagship (planner, synthesis) and current small model.
OPENAI_MODEL_REASONING=
OPENAI_MODEL_FAST=
# Stagehand act/extract/observe model; defaults to OPENAI_MODEL_FAST when empty.
STAGEHAND_MODEL=

# --- Baseten (L2) -------------------------------------------------------------------------------
BASETEN_API_KEY=
BASETEN_MODEL_API_BASE_URL=https://inference.baseten.co/v1
# Pick from GET /v1/models in Block 0.
BASETEN_TAGGER_MODEL=
# BEI deployment, e.g. https://model-<id>.api.baseten.co/environments/production/sync/v1
BASETEN_EMBED_BASE_URL=
BASETEN_EMBED_MODEL=

# --- Shopify ------------------------------------------------------------------------------------
# Our hosted UCP agent profile (design §6.4); Shopify's example profile URL until we deploy.
SHOPIFY_UCP_AGENT_PROFILE_URL=

# --- Storage and runner -------------------------------------------------------------------------
# file | pg
STORE=file
# Only when STORE=pg.
DATABASE_URL=
# FileRunStore root + artifacts + cache.
DATA_DIR=.data
# live | replay
RUNNER=live
# Replay timing multiplier.
REPLAY_SPEED=1
# read_write | read_only | off
CACHE_MODE=read_write

# --- Provider switches: live | fake (fixtures); enrich also accepts openai (fallback) ----------
CATALOG_PROVIDER=live
SEARCH_PROVIDER=live
FETCH_PROVIDER=live
BROWSER_PROVIDER=live
ENRICH_PROVIDER=live
REASON_PROVIDER=live

# --- Run budget (design §13.1) ------------------------------------------------------------------
RUN_BUDGET_TASKS=40
RUN_BUDGET_CATALOG_QUERIES=16
RUN_BUDGET_SEARCHES=12
RUN_BUDGET_FETCHES=60
RUN_BUDGET_SESSIONS_TOTAL=8
# Set to our Browserbase plan's concurrent-session limit once confirmed (M1-L1-2 human check).
RUN_BUDGET_SESSIONS_CONCURRENT=3
RUN_BUDGET_PAGES_PER_DOMAIN=4
RUN_BUDGET_EVIDENCE_UNITS=500
RUN_BUDGET_OPENAI_CALLS=16
RUN_BUDGET_BUNDLE_TOKENS=12000
# Wall clock: soft 4 min (skip remaining collection), hard 7 min (synthesize with what exists).
RUN_BUDGET_SOFT_MS=240000
RUN_BUDGET_HARD_MS=420000

# --- Feature flags ------------------------------------------------------------------------------
# Empty = follow the MILESTONES preset (off unless a preset turns it on).
# true|false (or 1|0) overrides the preset; any other value fails fast at startup.
# Preset-managed (README §3):
FEATURE_FULL_REPORT=
FEATURE_MAP=
FEATURE_MISSION_CONTROL=
FEATURE_PARTNER_VIEW=
FEATURE_ACTIONS=
FEATURE_BUNDLE_STUDIO=
FEATURE_SHOPIFY_WRITEBACK=
# Improvement slots (README §6, design §1.3). Also FEATURE_ADAPTER_<ID> per extra source adapter.
FEATURE_CAPTURE_MEDIA=
FEATURE_EXPORT=
FEATURE_EXPLORER=
FEATURE_GPTZERO=
FEATURE_DISTILLED_TAGGER=
FEATURE_ASK=
FEATURE_POLICIES=
FEATURE_TRENDS=
FEATURE_COMPOSIO=

# --- Observability and optional providers -------------------------------------------------------
# Empty disables Sentry. VITE_SENTRY_DSN is the only VITE_ value allowed to hold a key-like value.
SENTRY_DSN=
VITE_SENTRY_DSN=
GPTZERO_API_KEY=
COMPOSIO_API_KEY=

# --- M5 Shopify write-back (server only; M5 §3) -------------------------------------------------
# <name>.myshopify.com
SHOPIFY_ADMIN_SHOP=
SHOPIFY_ADMIN_TOKEN=
# Pinned in the write-back spike.
SHOPIFY_ADMIN_API_VERSION=
# Comma-separated shop domains allowed to receive draft products.
SHOPIFY_WRITE_ALLOWLIST=
# true in tests and rehearsals.
SHOPIFY_WRITEBACK_DRY_RUN=false
# Keep partner photos out of the merchant's store unless the partner agreed.
SHOPIFY_WRITEBACK_INCLUDE_PARTNER_MEDIA=false
