# Shopify Intent Studio v3. Copy locally; never commit keys or edit another user's .env.
# Active plan: docs/milestones/README.md. Providers below are intentionally fake until human spikes.
PORT=8787
WEB_PORT=5173
MILESTONES=s1
STORE=file
DATA_DIR=.data
RUNNER=replay
REPLAY_SPEED=1
CACHE_MODE=read_write
DATABASE_URL=

CATALOG_PROVIDER=fake
# Opt-in live catalog discovery: CATALOG_PROVIDER=browserbase (requires live vision briefs).
# IMAGE_NORMALIZER=sips is an optional macOS decoder; default is the documented container sanitizer.
MERCHANT_CATALOG_PROVIDER=live
# Use MERCHANT_CATALOG_PROVIDER=fake only for seed-only offline servers. Tests inject fetch/DNS.
# Live catalog origin does not make seed demand bands live. Humans spike real fetch/dns separately.
SEARCH_PROVIDER=fake
FETCH_PROVIDER=fake
BROWSER_PROVIDER=fake
ENRICH_PROVIDER=fake
REASON_PROVIDER=fake
VISION_PROVIDER=fake
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
OPENAI_API_KEY=
# Humans select vision-capable/structured-output-capable model IDs in S0.
OPENAI_MODEL_SEARCH=
OPENAI_MODEL_VISION=
OPENAI_MODEL_REASONING=
OPENAI_MODEL_PAIRINGS=
OPENAI_MODEL_FAST=
STAGEHAND_MODEL=
BASETEN_API_KEY=
BASETEN_MODEL_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_TAGGER_MODEL=
BASETEN_EMBED_BASE_URL=
BASETEN_EMBED_MODEL=
SHOPIFY_UCP_AGENT_PROFILE_URL=

# Both domains are mandatory; no flag disables outfit or setup.
# Blank follows the preset. Effective feature dependencies are validated.
FEATURE_INTENT_CAPTURE=
FEATURE_COLLECTION_MATCHING=
FEATURE_DEMAND_LEDGER=
FEATURE_MERCHANT_OPPORTUNITIES=
FEATURE_DRAFT_ACTIVATION=

# Proposed policy values; runtime services validate/consume them on their milestone cards.
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_EDGE_PX=1600
ASSET_TTL_HOURS=24
DEMAND_RETENTION_DAYS=30
DEMAND_MIN_SESSIONS=5
DEMAND_SNAPSHOT_MINUTES=15
PRODUCT_FACT_TTL_MINUTES=15
RUN_BUDGET_CATALOG_QUERIES=12
RUN_BUDGET_FETCHES=12
RUN_BUDGET_SESSIONS_TOTAL=2
RUN_BUDGET_SESSIONS_CONCURRENT=2
RUN_BUDGET_OPENAI_CALLS=6
RUN_BUDGET_SOFT_MS=90000
RUN_BUDGET_HARD_MS=180000
SENTRY_DSN=
VITE_SENTRY_DSN=

# Optional S5: server-only owned-store access; no automatic execution in bootstrap.
SHOPIFY_ADMIN_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=
SHOPIFY_WRITE_ALLOWLIST=
SHOPIFY_WRITEBACK_DRY_RUN=true
SHOPIFY_WRITEBACK_INCLUDE_PARTNER_MEDIA=false

# Legacy m-presets remain supported, but do not mix them with s-presets.
# Old optional providers/flags are archived and not on the active build path.
